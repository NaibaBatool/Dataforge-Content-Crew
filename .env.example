# DataForge Content Crew Configuration

# Server Settings
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
DATABASE_PATH=content_crew.db

# ------------------------------------------------------------------------------
# Google Gemini API Configuration (Phase 3)
# ------------------------------------------------------------------------------
# How to get your Gemini API Key:
# 1. Visit Google AI Studio at: https://aistudio.google.com/
# 2. Sign in with your Google account.
# 3. Click "Get API key" and create a key in a new or existing Google Cloud project.
# 4. Paste the key below (keep it confidential, never commit to git):
GEMINI_API_KEY=your_gemini_api_key_here


# Configurable Gemini Model (e.g., gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Optional Live Web Search Provider (Phase 3)
# ------------------------------------------------------------------------------
# If left blank, the research node uses verified local competitor intelligence
# and truthfully reports that external live search is unconfigured.
TAVILY_API_KEY=
